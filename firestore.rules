rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }

    // Users collection - users can only read and write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow delete: if false; // Never allow user deletion via client
    }

    // Courses collection - public read access for pricing display, admins can write
    match /courses/{courseId} {
      allow read: if true; // Allow anyone to read courses for pricing display
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Features collection - public read access for course features display
    match /features/{courseId} {
      allow read: if true; // Allow anyone to read course features for pricing display
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Free roadmap content - public read, admin controlled
    match /roadmaps/{roadmapId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Free roadmap progress - owned by each signed-in user
    match /roadmap_progress/{progressId} {
      allow get: if isAuthenticated() &&
                    (progressId.matches(request.auth.uid + '_.*') || isAdmin());

      // List queries must be filtered to the caller's own documents —
      // Firestore proves this from the query's where('user_id','==',uid)
      allow list: if isAuthenticated() &&
                     (resource.data.user_id == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.keys().hasAll(['user_id', 'roadmap_id', 'completed']) &&
                       request.resource.data.user_id is string &&
                       request.resource.data.roadmap_id is string &&
                       request.resource.data.completed is map;

      allow update: if isAuthenticated() &&
                       resource.data.user_id == request.auth.uid &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.roadmap_id == resource.data.roadmap_id &&
                       request.resource.data.completed is map;

      allow delete: if isAdmin();
    }
    
    // Videos collection - STRICT ACCESS CONTROL
    match /videos/{videoId} {
      // Video metadata is readable by course owners, admins, and — for
      // free-preview lessons — anyone
      allow read: if resource.data.is_preview == true ||
                     isAdmin() ||
                     (isAuthenticated() &&
                      exists(/databases/$(database)/documents/user_courses/$(request.auth.uid + '_' + resource.data.course_id)));
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // User courses collection - STRICT OWNERSHIP
    match /user_courses/{userCourseId} {
      // Covers get and list; lists must be filtered to the caller's own
      // documents (where('user_id','==',uid)) for Firestore to prove this
      allow read: if isAuthenticated() &&
                     (resource.data.user_id == request.auth.uid || isAdmin());

      // Enrollments are created server-side only, after a verified payment
      allow create: if false;

      // Owners may update display metadata (last_accessed, course title) but
      // never which user or course the enrollment is for
      allow update: if isAuthenticated() &&
                       resource.data.user_id == request.auth.uid &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.course_id == resource.data.course_id;

      allow delete: if false; // Never allow deletion via client
    }
    
    // User progress collection - STRICT OWNERSHIP
    match /user_progress/{progressId} {
      // Covers get and list (lists must filter on the caller's user_id)
      allow read: if isAuthenticated() &&
                     (resource.data.user_id == request.auth.uid || isAdmin());

      // Progress is only writable for a lesson of a course the caller has
      // paid for — otherwise anyone could mark lessons complete and claim a
      // certificate for a course they never bought
      allow create: if isAuthenticated() &&
                       progressId == request.auth.uid + '_' + request.resource.data.video_id &&
                       request.resource.data.user_id == request.auth.uid &&
                       isValidProgress();

      allow update: if isAuthenticated() &&
                       resource.data.user_id == request.auth.uid &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.video_id == resource.data.video_id &&
                       request.resource.data.course_id == resource.data.course_id &&
                       isValidProgress();

      allow delete: if false; // Never allow deletion via client
    }

    function isValidProgress() {
      return request.resource.data.video_id is string &&
             request.resource.data.course_id is string &&
             get(/databases/$(database)/documents/videos/$(request.resource.data.video_id)).data.course_id == request.resource.data.course_id &&
             get(/databases/$(database)/documents/payments/$(request.auth.uid + '_' + request.resource.data.course_id)).data.status == 'completed';
    }
    
    // Payments collection - ULTRA STRICT
    match /payments/{paymentId} {
      // Covers get and list (lists must filter on the caller's user_id)
      allow read: if isAuthenticated() &&
                     (resource.data.user_id == request.auth.uid || isAdmin());

      // Payment records are created and updated only by the server
      // (create-payment, verify-payment and the webhooks, via Admin SDK)
      allow create: if false;
      allow update: if false;
      
      allow delete: if false; // Never allow payment deletion via client
    }
    
    // Explicit deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
