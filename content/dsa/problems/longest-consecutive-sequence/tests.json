{
  "fn": "longestConsecutive",
  "params": ["int[]"],
  "returns": "int",
  "cases": [
    { "in": [[100, 4, 200, 1, 3, 2]], "out": 4 },
    { "in": [[0, 3, 7, 2, 5, 8, 4, 6, 0, 1]], "out": 9 },
    { "in": [[]], "out": 0 },
    { "in": [[1, 0, 1, 2]], "out": 3 },
    { "in": [[-1, -2, 5]], "out": 2 },
    { "in": [[9]], "out": 1 },
    { "in": [[10, 5, 12, 3, 55, 30, 4, 11, 2]], "out": 4 }
  ]
}
